# Maintainer: Tino Gohl <tuvbunn2@googlemail.com>
pkgname=jgrep
pkgver=1.3.0
pkgrel=1
pkgdesc="grep for JSON, NDJSON, and YAML using jq expressions"
arch=('x86_64')
url="https://github.com/subnix-work/jgrep"
license=('Apache-2.0')
makedepends=('cargo')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/subnix-work/jgrep/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
    cd "${srcdir}/jgrep-${pkgver}"

    cargo build --release --locked -p jgrep
}

package() {
    cd "${srcdir}/jgrep-${pkgver}"

    install -Dm755 "target/release/jgrep" "${pkgdir}/usr/bin/jgrep"
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
